# Copy this file to .env and fill in your own value. .env is gitignored.
# Nothing in this project writes your SSID into any file for you.

# REQUIRED. The complete Socket.IO authentication string from your own
# authenticated Pocket Option session, in this form:
#   42["auth",{"session":"...","isDemo":1,"uid":12345,"platform":...}]
# Wrap it in single quotes. Only bridge/po_bridge.py reads it. The Node
# scanner never sees it. It is the only SSID variable.
POCKET_OPTION_SSID=

# Optional: port for the bridge on 127.0.0.1 (default 8765)
# PO_BRIDGE_PORT=8765

# Optional: pin the scanner to one specific available OTC asset. It must be
# an available OTC asset in the real catalog, and there is no fallback if it
# is not. Leave unset to use the available OTC asset with the highest payout.
# SCANNER_ASSET=